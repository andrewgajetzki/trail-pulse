EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP/api

# This is the Web OAuth client ID from Google Cloud Console, not a secret.
# It must match GOOGLE_CLIENT_ID in the backend .env file.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-your-web-oauth-client-id

# Android Maps SDK key. Restrict it in Google Cloud to the Android app package
# and the SHA-1 certificate fingerprints used by your development/release builds.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-your-android-maps-api-key
