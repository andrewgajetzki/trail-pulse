POSTGRES_DB=trail_pulse
POSTGRES_USER=trail_pulse
POSTGRES_PASSWORD=replace-with-a-secure-password

# Generate a long random value, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OAuth 2.0 client ID for the Google Sign-In app used by Trail Pulse.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

SITE_ADDRESS=trail-pulse.gajetzki.com

# Mobile app configuration. These EXPO_PUBLIC_ values are included in the app bundle.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP/api

# This is the Web OAuth client ID from Google Cloud Console, not a secret.
# It must match GOOGLE_CLIENT_ID above.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-your-web-oauth-client-id

# Android Maps SDK key. Restrict it to the Android app package and its signing certificates.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-your-android-maps-api-key
