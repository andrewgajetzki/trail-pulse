POSTGRES_DB=trail_pulse
POSTGRES_USER=trail_pulse
POSTGRES_PASSWORD=replace-with-a-secure-password

# Generate a long random value, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OAuth 2.0 client ID for the Google Sign-In app used by Trail Pulse.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

SITE_ADDRESS=trail-pulse.gajetzki.com